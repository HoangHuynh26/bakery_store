# ==============================================================================
# MAISON DOUCE BAKERY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local overrides (never commit .env to version control)
# ==============================================================================

# Application
APP_ENV=development
APP_NAME="Maison Douce Bakery"
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maison_douce_bakery
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# Neon Production Database URL (alternative to separate host/port)
# DATABASE_URL=postgresql://user:password@ep-example.neon.tech/maison_douce_bakery?sslmode=require

# JWT Security
# Ensure JWT_SECRET is at least 256 bits (32+ characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000          # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Transactional Email (Resend / SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=support@maisondouce.vn
MAIL_FROM_NAME="Maison Douce Bakery"

# Media Storage (Cloudinary / Local Adapter)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed Super Admin (used for first bootstrap in dev)
ADMIN_DEFAULT_EMAIL=admin@maisondouce.vn
ADMIN_DEFAULT_PASSWORD=Admin@MaisonDouce2026!

# Frontend Environment Variables (prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME="Maison Douce Bakery"
VITE_CURRENCY=VND
